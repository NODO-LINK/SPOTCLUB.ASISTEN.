rules_version = '2';
// Reglas de seguridad de THE SPOT. Publicar en Firebase Console > Firestore Database > Rules > Publish
// (o con `firebase deploy --only firestore:rules`).
// Sin documento en usuarios/{uid} se asume rol "admin", igual que el panel, para no dejar a nadie fuera.
// IMPORTANTE: por eso hay que desactivar el registro libre en Authentication > Settings > User actions
// (quitar "Enable create (sign-up)"). Así solo existen las cuentas que tú creas en Authentication > Users.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function rol() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
        : 'admin';
    }
    function esAdmin()  { return signedIn() && rol() == 'admin'; }
    function esVentas() { return signedIn() && rol() in ['admin', 'ventas']; }

    // Pedidos: solo administración puede borrar. Los demás anulan con motivo (la anulación la hace administración).
    match /ventas/{id} {
      allow read: if signedIn();
      allow create: if esVentas();
      allow update: if signedIn() && (
        esVentas() ||
        // despacho solo cambia la entrega
        (rol() == 'despacho' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['logistica', 'etapaDesde', 'historial', 'guia']))
      );
      allow delete: if esAdmin();
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if esAdmin();
    }

    // Existencias: las mueven las ventas y los ajustes de inventario.
    match /inventario/{id} {
      allow read: if esVentas();
      allow write: if esVentas();
    }

    // Notas de clientes (la ficha en sí se arma con las ventas).
    match /clientes/{id} {
      allow read, write: if esVentas();
    }

    // Estado de las publicaciones de Instagram (la lista de diseños vive en contenido/contenido.json).
    match /publicaciones/{id} {
      allow read, write: if esVentas();
    }

    // Diseños creados con el generador del panel (imagen incluida).
    match /piezas_gen/{id} {
      allow read, write: if esVentas();
    }

    // Recordatorios propios del administrador y su equipo de ventas.
    match /recordatorios/{id} {
      allow read, write: if esVentas();
    }

    match /contadores/{id} {
      allow read: if signedIn();
      allow write: if esVentas();
    }

    // Registro de cambios: cualquiera con sesión escribe, solo administración lee.
    match /auditoria/{id} {
      allow create: if signedIn();
      allow read: if esAdmin();
      allow update, delete: if false;
    }

    // Roles: cada persona lee el suyo, solo administración los asigna.
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }
  }
}
